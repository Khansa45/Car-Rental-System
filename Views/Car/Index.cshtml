@model IEnumerable<Lab_04.Models.Car>

<div class="container my-4">
    <h2 class="mb-2">Available Cars</h2>
    <p class="text-muted">Select a car to book.</p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No cars are currently available.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var car in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm p-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="card-title mb-0">@car.name</h5>
                                    <span class="badge bg-success">Available</span>
                                </div>
                                <p class="card-text text-muted">PKR @car.pricePerDay / day</p>
                            </div>
                            <form asp-action="Book" method="post" class="mt-3">
                                <input type="hidden" name="Id" value="@car.id" />
                                <button type="submit" class="btn btn-primary w-100">Book Car</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>