@model IEnumerable<Lab_04.Models.Car>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Booked Cars</h2>
        <a asp-controller="Car" asp-action="Index" class="btn btn-secondary">Back to Cars</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No cars have been booked yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Car Name</th>
                        <th>Price Per Day</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var car in Model)
                    {
                        <tr>
                            <td>@car.id</td>
                            <td>@car.name</td>
                            <td>PKR @car.pricePerDay</td>
                            <td><span class="badge bg-warning text-dark">Booked</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>